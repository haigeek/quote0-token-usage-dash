# dot.mindreset.tech credentials
QUOTE_API_KEY=dot_app_...
QUOTE_DEVICE_ID=XXXXXXXXXXXX

# Set to false to skip Claude fetching (default: true)
# CLAUDE_ENABLED=false

# Set to false to skip OpenAI Codex fetching (default: true)
# OPENAI_ENABLED=false

# Set to false to skip OpenCode Go fetching (default: true)
# OPENCODE_ENABLED=false

# Optional: override Claude OAuth token
# (default: read from ~/.claude/.credentials.json)
# CLAUDE_ACCESS_TOKEN=
# CLAUDE_REFRESH_TOKEN=
# CLAUDE_EXPIRES_AT=

# Optional: where refreshed Claude tokens are cached when using env vars
# (default: ~/.cache/token-usage-dash/claude_token.json)
# CLAUDE_TOKEN_CACHE=/data/claude_token.json

# Optional: override Codex OAuth token (default: read from ~/.codex/auth.json)
# CODEX_ACCESS_TOKEN=
# CODEX_ACCOUNT_ID=
# CODEX_REFRESH_TOKEN=

# Optional: where refreshed Codex tokens are cached when using env vars
# (default: ~/.cache/token-usage-dash/codex_token.json)
# CODEX_TOKEN_CACHE=/tmp/codex_token.json

# Optional: override OpenCode Go API key
# (default: read the "opencode-go" entry from ~/.local/share/opencode/auth.json)
# OPENCODE_GO_API_KEY=

# Seconds between updates in --loop mode (default: 1800)
# UPDATE_INTERVAL=1800

# Timezone for the clock rendered in the image (Docker default: Asia/Shanghai)
# TZ=Asia/Shanghai

# Proxy for outbound API calls, used by docker-compose.yml
# HTTP_PROXY_HOST=http://host.docker.internal:7890

# Optional Dot Image API settings
# QUOTE_LINK=https://example.com
# QUOTE_BORDER=0
# QUOTE_DITHER_TYPE=NONE
# QUOTE_DITHER_KERNEL=
# QUOTE_TASK_KEY=
# QUOTE_TASK_ALIAS=
